            ELSE CC
        END AS CC,
        RECIPIENT_COUNT,    
        SUBJECT,    
        FOLDER,
        SPLIT(ALL_LABELS, ', INBOX')[0] AS ALL_LABELS,    
        SIZE_BYTES,
        ATTACHMENT_COUNT,
        HAS_ATTACHMENTS,  
        IS_READ,
        IS_STARRED,
        IS_REPLIED,   
        TO_TIMESTAMP(THREAD_FIRST_MESSAGE_AT, 'DD/MM/YYYY HH24:MI') AS THREAD_FIRST_MESSAGE_AT,           
        THREAD_PARTICIPANT_COUNT,
        RANK () OVER (PARTITION BY MESSAGE_ID ORDER BY THREAD_FIRST_MESSAGE_AT desc) AS rnk
    from email_db.raw.gmail_data
)
SELECT         
        ROW_NUMBER() OVER (ORDER BY THREAD_FIRST_MESSAGE_AT DESC) AS SL,
        SENDER_NAME,
        sender_email,
        SENDER_DOMAIN,
        SENDER_DOMAIN_TYPE,
        CC,
        RECIPIENT_COUNT,    
