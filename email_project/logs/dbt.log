    as (
with msg_rank as(
    SELECT 
        MESSAGE_ID,
        LOWER(SENDER_EMAIL) AS sender_email,
        SENDER_DISPLAY_NAME AS SENDER_NAME,
        SENDER_DOMAIN,
        SENDER_DOMAIN_TYPE,
        CASE
