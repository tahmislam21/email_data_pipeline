        FOLDER,
        SPLIT(ALL_LABELS, ', INBOX')[0] AS ALL_LABELS,    
        SIZE_BYTES,
        ATTACHMENT_COUNT,
        HAS_ATTACHMENTS,  
        IS_READ,
