  as (
    
with msg_rank as(
    SELECT 
        MESSAGE_ID,
        --SENDER_RAW,
        LOWER(SENDER_EMAIL) AS sender_email,
        SENDER_DISPLAY_NAME AS SENDER_NAME,
        SENDER_DOMAIN,
        SENDER_DOMAIN_TYPE,
        CASE
            WHEN CC IS NULL THEN 'None'
            ELSE CC
        END AS CC,
        RECIPIENT_COUNT,    
        SUBJECT,    
        TO_DATE(FULL_DATE ,'DD/MM/YYYY') as email_date,
        --YEAR,
        --QUARTER,
        --MONTH,
        --MONTH_NAME,
        --WEEK,
        DAY_OF_WEEK,
        --DAY_NAME,
        --IS_WEEKEND,    
        --FULL_TIME,
        --HOUR,
        --MINUTE,
        --AM_PM,
        --TIME_BUCKET,
        FOLDER,
        SPLIT(ALL_LABELS, ',')[0] AS LABEL_1,
        SPLIT(ALL_LABELS, ',')[1] AS LABEL_2,
        SPLIT(ALL_LABELS, ',')[2] AS LABEL_3,
        SPLIT(ALL_LABELS, ',')[3] AS LABEL_4
        ALL_LABELS,    
        SIZE_BYTES,
        ATTACHMENT_COUNT,
        HAS_ATTACHMENTS,  
        IS_READ,
        IS_STARRED,
        IS_REPLIED,   
        --THREAD_SUBJECT,
        TO_TIMESTAMP(THREAD_FIRST_MESSAGE_AT, 'DD/MM/YYYY HH24:MI') AS THREAD_FIRST_MESSAGE_AT,    
        --THREAD_DURATION_SEC,       
        THREAD_PARTICIPANT_COUNT,
        RANK () OVER (PARTITION BY MESSAGE_ID ORDER BY FULL_DATE desc) AS rnk
    from email_db.raw.gmail_data
)
SELECT         
        MESSAGE_ID,
        SENDER_NAME,
        sender_email,
        SENDER_DOMAIN,
        SENDER_DOMAIN_TYPE,
        CC,
        RECIPIENT_COUNT,    
        SUBJECT,    
        email_date,
        DAY_OF_WEEK,
        FOLDER,
        ALL_LABELS,    
        SIZE_BYTES,
        ATTACHMENT_COUNT,
        HAS_ATTACHMENTS,  
        IS_READ,
        IS_STARRED,
        IS_REPLIED, 
        THREAD_FIRST_MESSAGE_AT,           
        THREAD_PARTICIPANT_COUNT, 
    FROM msg_rank WHERE rnk = 1
  )
